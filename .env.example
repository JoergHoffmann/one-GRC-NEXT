# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# APP_BASIC_AUTH: Optionaler Zugriffsschutz (HTTP Basic Auth) für die gesamte Anwendung
# inkl. KI-Endpunkt. Format "benutzer:passwort". Nur in Verbindung mit HTTPS betreiben.
# Dringend empfohlen für jeden öffentlich erreichbaren Betrieb.
APP_BASIC_AUTH=""

# AI_RATE_LIMIT_PER_MINUTE: Maximale KI-Anfragen pro Client-IP und Minute (Standard: 10).
AI_RATE_LIMIT_PER_MINUTE="10"

# TRUST_PROXY: Welchen Proxys Express beim Ermitteln der Client-IP vertraut (X-Forwarded-For).
# Leer/"false" (Standard) = keinem Proxy vertrauen – richtig, wenn der Server direkt erreichbar ist.
# Hinter Cloud Run oder genau einem Reverse Proxy: "1". Auch möglich: "loopback" oder IP-/Subnetz-Liste.
# Niemals "true" setzen, wenn der Server auch direkt (ohne Proxy) erreichbar ist.
TRUST_PROXY=""
